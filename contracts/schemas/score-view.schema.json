        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "pricing_policy_id": {
      "title": "Pricing Policy Id",
      "type": "string"
    },
    "pricing_policy_sha256": {
      "title": "Pricing Policy Sha256",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "reasoning_tokens": {
      "anyOf": [
