          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Criterion Scores",
      "type": "object"
    },
    "criterion_verdicts": {
      "additionalProperties": {
        "$ref": "#/$defs/JudgmentVerdict"
      },
