{
  "$defs": {
    "ArtifactValidity": {
      "enum": [
        "valid",
        "invalid",
        "contested",
        "instrument_failure",
        "not_proven"
      ],
      "title": "ArtifactValidity",
      "type": "string"
    },
    "ComparabilityStatus": {
      "enum": [
        "directly_comparable",
        "diagnostically_comparable",
        "valid_non_comparable"
      ],
      "title": "ComparabilityStatus",
      "type": "string"
    },
    "Confidentiality": {
      "enum": [
        "public",
        "controlled",
        "private_canary",
        "retired_audit"
      ],
      "title": "Confidentiality",
      "type": "string"
    },
    "Instrument": {
      "enum": [
        "surface_conformance",
        "execution_core",
        "editorial_core",
        "project_field",
        "revision_recovery",
        "judge_qualification"
      ],
      "title": "Instrument",
      "type": "string"
    },
    "JudgmentStatus": {
      "enum": [
        "unjudged",
        "self_judged",
        "qualified_panel_judged",
        "human_adjudicated"
      ],
      "title": "JudgmentStatus",
      "type": "string"
    },
    "JudgmentVerdict": {
      "enum": [
        "accept",
        "reject",
        "indeterminate",
        "insufficient_basis"
      ],
      "title": "JudgmentVerdict",
      "type": "string"
    },
    "ProvenanceStatus": {
      "enum": [
        "self_submitted",
        "peer_reproduced",
        "official_reproduced",
        "official_hosted",
        "attested_environment"
      ],
      "title": "ProvenanceStatus",
      "type": "string"
    },
    "TrustReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_validity": {
          "$ref": "#/$defs/ArtifactValidity",
          "default": "not_proven"
        },
        "comparability": {
          "$ref": "#/$defs/ComparabilityStatus",
          "default": "valid_non_comparable"
        },
        "confidentiality": {
          "$ref": "#/$defs/Confidentiality",
          "default": "public"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "judgment_status": {
          "$ref": "#/$defs/JudgmentStatus",
          "default": "unjudged"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceStatus",
          "default": "self_submitted"
        }
      },
      "title": "TrustReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_work": {
      "title": "Accepted Work",
      "type": "boolean"
    },
    "artifact_valid": {
      "title": "Artifact Valid",
      "type": "boolean"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "candidate_list_equivalent_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate List Equivalent Cost Usd"
    },
    "candidate_metered_cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
