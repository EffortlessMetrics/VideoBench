  "required": [
    "task_id",
    "family_id",
    "form_id",
    "instrument",
    "execution_pack_sha256",
    "attempt_id",
    "stack_id",
    "work_result_sha256",
    "verification_sha256",
    "scoring_policy_sha256",
    "pricing_policy_sha256",
    "accepted_work",
    "artifact_valid",
    "hard_contract_pass",
    "semantic_acceptance",
    "criterion_scores",
    "criterion_verdicts",
    "reason_codes",
    "candidate_metered_cost_usd",
    "model_calls",
    "tool_calls",
    "wall_seconds",
