      "type": "string"
    },
    "hard_contract_pass": {
      "title": "Hard Contract Pass",
      "type": "boolean"
    },
    "human_seconds": {
      "minimum": 0.0,
      "title": "Human Seconds",
      "type": "number"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
