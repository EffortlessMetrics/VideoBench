    },
    "verification_sha256": {
      "title": "Verification Sha256",
      "type": "string"
    },
    "wall_seconds": {
      "minimum": 0.0,
      "title": "Wall Seconds",
      "type": "number"
    },
    "work_result_sha256": {
      "title": "Work Result Sha256",
      "type": "string"
    }
