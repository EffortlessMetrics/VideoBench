{
  "$defs": {
    "HarnessPolicy": {
      "additionalProperties": false,
      "properties": {
        "context_policy": {
          "default": "default",
          "title": "Context Policy",
          "type": "string"
        },
        "harness": {
          "title": "Harness",
          "type": "string"
        },
        "memory_policy": {
          "default": "none",
          "title": "Memory Policy",
          "type": "string"
        },
        "orchestration_policy": {
          "default": "single_agent",
          "title": "Orchestration Policy",
          "type": "string"
        },
        "prompt_policy": {
          "default": "default",
          "title": "Prompt Policy",
          "type": "string"
        },
        "scaffold_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scaffold Hash"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "harness"
      ],
      "title": "HarnessPolicy",
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "product_surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Surface"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "OperatorPolicy": {
      "enum": [
        "autonomous",
        "scripted_collaboration",
        "expert_operated"
      ],
      "title": "OperatorPolicy",
      "type": "string"
    },
    "ResolveEnvironment": {
      "additionalProperties": false,
      "properties": {
        "codecs": {
          "items": {
            "type": "string"
          },
          "title": "Codecs",
          "type": "array"
        },
        "color_management": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Management"
        },
        "display_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Profile"
        },
        "environment_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Digest"
        },
        "fonts": {
          "items": {
            "type": "string"
          },
          "title": "Fonts",
          "type": "array"
        },
        "gpu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu"
        },
        "machine_id": {
          "default": "unknown",
          "title": "Machine Id",
          "type": "string"
        },
        "operating_system": {
          "title": "Operating System",
          "type": "string"
        },
        "plugins": {
          "items": {
            "type": "string"
          },
          "title": "Plugins",
          "type": "array"
        },
        "resolve_edition": {
          "default": "unknown",
          "title": "Resolve Edition",
          "type": "string"
        },
        "resolve_version": {
          "title": "Resolve Version",
          "type": "string"
        }
      },
      "required": [
        "operating_system",
        "resolve_version"
      ],
      "title": "ResolveEnvironment",
      "type": "object"
    },
    "ResourceEnvelope": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Candidate Cost Usd"
        },
        "max_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Input Tokens"
        },
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Calls"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "ResourceEnvelope",
      "type": "object"
    },
    "SurfaceKind": {
      "enum": [
        "none",
        "mcp_compound",
        "mcp_granular",
        "resolve_scripting",
        "gui",
        "command",
        "manual",
        "hybrid"
      ],
      "title": "SurfaceKind",
      "type": "string"
    },
    "SurfaceProfile": {
      "additionalProperties": false,
      "properties": {
        "action_surface": {
          "$ref": "#/$defs/SurfaceKind"
        },
        "allowed_external_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed External Tools",
          "type": "array"
        },
        "media_analysis_surface": {
          "$ref": "#/$defs/SurfaceKind",
          "default": "none"
        },
        "network_policy": {
          "default": "declared",
          "title": "Network Policy",
          "type": "string"
        },
        "observation_surface": {
          "$ref": "#/$defs/SurfaceKind"
        },
        "tool_granularity": {
          "default": "unspecified",
          "title": "Tool Granularity",
          "type": "string"
        },
        "verification_access": {
          "$ref": "#/$defs/SurfaceKind",
          "default": "none"
        }
      },
      "required": [
        "observation_surface",
        "action_surface"
      ],
      "title": "SurfaceProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "environment": {
      "$ref": "#/$defs/ResolveEnvironment"
    },
    "harness": {
      "$ref": "#/$defs/HarnessPolicy"
    },
    "known_unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Known Unknowns",
      "type": "array"
    },
    "operator_policy": {
      "$ref": "#/$defs/OperatorPolicy",
      "default": "autonomous"
    },
    "resource_envelope": {
      "$ref": "#/$defs/ResourceEnvelope"
    },
    "stack_id": {
      "title": "Stack Id",
      "type": "string"
    },
    "surface": {
      "$ref": "#/$defs/SurfaceProfile"
    },
    "system": {
      "$ref": "#/$defs/ModelIdentity"
    }
  },
  "required": [
    "stack_id",
    "system",
    "surface",
    "harness",
    "environment"
  ],
  "title": "RunStack",
  "type": "object"
}
